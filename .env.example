# کلید موتور LLM — هر کدام موجود باشد استفاده می‌شود (اولویت: Anthropic، بعد OpenAI)
# بدون هیچ کلیدی، موتور آزمایشی (FakeEngine) فعال است.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# انتخاب صریح موتور: anthropic | openai | fake (اختیاری)
# MONAD_ENGINE=openai

# در صورت نیاز به relay/gateway (مثلاً وقتی سرور دسترسی مستقیم ندارد)
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com

# شناسه مدل (اختیاری — پیش‌فرض: claude-sonnet-5 برای Anthropic و gpt-5 برای OpenAI)
# MONAD_MODEL=gpt-5

# مسیر پایگاه داده SQLite
MONAD_DB_PATH=./data/monad.db

# سقف گفتگوی روزانه به ازای هر IP
MONAD_DAILY_CONVERSATIONS=10

# سقف پیام روزانه به ازای هر IP
MONAD_DAILY_MESSAGES=200

# سقف ترجمه روزانه به ازای هر IP (ترجمه‌ها کش می‌شوند)
MONAD_DAILY_TRANSLATIONS=100

# نمک هش برای ناشناس‌سازی IP (در استقرار واقعی مقدار تصادفی بلند بگذارید)
MONAD_SALT=change-me-in-production

# نشانی صفحه/درگاه هدیه (مثلاً باکس اهدای زرین‌پال). اگر خالی باشد، پیام «به‌زودی».
MONAD_GIFT_URL=

# --- هویت اختیاری (ورود با ایمیل/گوگل) ---
# نشانی عمومی برنامه (برای ساخت لینک جادویی). در تولید: https://asraar.ir
APP_URL=http://localhost:3000

# سقف درخواست ورود روزانه به ازای هر IP
MONAD_DAILY_LOGINS=20

# SMTP برای لینک جادویی. اگر تنظیم نشود، لینک در کنسول چاپ می‌شود (فقط توسعه).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=مناد <no-reply@asraar.ir>

# ورود با گوگل (OAuth). اگر تنظیم نشود، دکمه‌ی گوگل پنهان می‌ماند.
# در Google Cloud Console یک OAuth Client بسازید و redirect زیر را مجاز کنید:
#   https://asraar.ir/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

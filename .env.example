# کلید موتور LLM — اگر خالی باشد، موتور آزمایشی (FakeEngine) استفاده می‌شود
ANTHROPIC_API_KEY=

# در صورت نیاز به relay/gateway (مثلاً وقتی سرور به api.anthropic.com دسترسی مستقیم ندارد)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# شناسه مدل (قابل تعویض؛ Core به هیچ مدلی وابسته نیست)
MONAD_MODEL=claude-sonnet-5

# مسیر پایگاه داده SQLite
MONAD_DB_PATH=./data/monad.db

# سقف گفتگوی روزانه به ازای هر IP
MONAD_DAILY_CONVERSATIONS=10

# سقف پیام روزانه به ازای هر IP
MONAD_DAILY_MESSAGES=200

# سقف ترجمه روزانه به ازای هر IP (ترجمه‌ها کش می‌شوند)
MONAD_DAILY_TRANSLATIONS=100

# نمک هش برای ناشناس‌سازی IP (در استقرار واقعی مقدار تصادفی بلند بگذارید)
MONAD_SALT=change-me-in-production
